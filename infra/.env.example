# Copy this file to "infra/.env" and fill in the values. ".env" is NOT committed.
# Generate each password with:  openssl rand -hex 16

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017

# Password of the "super_admin_auth" database user, the one the backend connects with. The backend's
# MONGODB_URI (packages/services/necto-api/.env) must use this same value. The database and user keep their
# original name on purpose: the app name and the physical database name are independent.
SUPER_ADMIN_AUTH_DB_PASSWORD=
