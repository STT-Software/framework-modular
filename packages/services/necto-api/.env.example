# Copy this file to ".env" and fill in the values. ".env" is NOT committed.
# MongoDB runs from the shared dev infrastructure: see infra/.env.example.

# Connection to the backend's database. The password must match SUPER_ADMIN_AUTH_DB_PASSWORD in
# infra/.env. If it has special characters (@ : / ?), they must be URL-encoded.
# The physical database is still called "super_admin_auth" (its original name, kept so no data has to be
# migrated). The code never mentions it: to use another name, change it here and in infra/mongo-init.
MONGODB_URI=mongodb://super_admin_auth:<password>@localhost:27017/super_admin_auth?authSource=super_admin_auth

PORT=8080
# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:6020

# Minimum 32 characters. Generate one with:  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1h

# ── Access of the business boss: one-time codes sent by email ────────────────────────────────────
# Key that protects the codes stored in the database (HMAC). Minimum 32 characters, DIFFERENT from
# JWT_SECRET, never committed. Generate one with:  openssl rand -hex 48
OTP_SECRET=

# Public address of the web app: the link in the email points to <PUBLIC_APP_URL>/business/access
PUBLIC_APP_URL=http://localhost:6020

# Policy of the codes (optional; these are the defaults).
# OTP_TTL_MINUTES=10                  how long a code is valid
# OTP_MAX_ATTEMPTS=5                  tries allowed against ONE code before it is locked
# OTP_RESEND_COOLDOWN_SECONDS=60      minimum time between two codes for the same person and business
# OTP_ATTEMPT_WINDOW_MINUTES=15       window for the limits below
# OTP_CONTEXT_ATTEMPT_LIMIT=10        tries per person+business in that window, over ALL their codes
# OTP_IP_ATTEMPT_LIMIT=30             tries per IP in that window
# OTP_SEND_WINDOW_MINUTES=60          window for the limits below
# OTP_CONTEXT_SEND_LIMIT=5            codes per person+business in that window (also caps invitation resends)
# OTP_IP_SEND_LIMIT=20                codes requested per IP in that window

# ── Outgoing email (SMTP) ────────────────────────────────────────────────────────────────────────
# Without MAIL_SMTP_HOST no email can be sent: the invitation is recorded as "failed: not-configured"
# and can be sent again from the business page once mail is set up. Nothing is ever faked.
# Use the credentials your provider gives you (an SMTP relay of your company, Amazon SES, Mailgun,
# SendGrid, Gmail with an app password...). TLS certificates are always verified.
MAIL_SMTP_HOST=
# 587 + STARTTLS (MAIL_SMTP_SECURE=false) or 465 + implicit TLS (MAIL_SMTP_SECURE=true).
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
# With MAIL_SMTP_SECURE=false, refuse to send if the server does not offer STARTTLS. Only set this to
# false for a local test server that has no TLS (never in production).
MAIL_SMTP_REQUIRE_TLS=true
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
# Sender, as the provider authorized it (the domain must be verified with the provider: SPF/DKIM).
# Example: Necto <no-reply@your-domain.com>
MAIL_FROM=
