# Copy this file to ".env" and fill in the values. ".env" is NOT committed.
# MongoDB runs from the shared dev infrastructure: see infra/.env.example.

# Connection to this service's own database. The password must match
# ONBOARDING_DB_PASSWORD in infra/.env. If it has special characters
# (@ : / ?), they must be URL-encoded.
MONGODB_URI=mongodb://onboarding:<password>@localhost:27017/onboarding?authSource=onboarding

PORT=8081

# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:6020

# MUST be the same value as JWT_SECRET in packages/services/super-admin-auth/.env:
# this service validates the tokens that super-admin-auth issues (HS256), without
# calling it. Minimum 32 characters.
JWT_SECRET=
