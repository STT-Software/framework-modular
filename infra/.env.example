# Copy this file to "infra/.env" and fill in the values. ".env" is NOT committed.
# Generate each password with:  openssl rand -hex 16

MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_PORT=27017

# Password of the "super_admin_auth" database user. The service's own
# MONGODB_URI (packages/services/super-admin-auth/.env) must use this same value.
SUPER_ADMIN_AUTH_DB_PASSWORD=
# Password of the "onboarding" database user. The service's own
# MONGODB_URI (packages/services/onboarding/.env) must use this same value.
ONBOARDING_DB_PASSWORD=
