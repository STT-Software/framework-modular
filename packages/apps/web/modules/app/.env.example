# Copy this file to ".env" only if you need to override the defaults.

# Dónde corre el backend (necto-api) para el dev server de Vite. Por defecto http://localhost:8080.
# (SUPER_ADMIN_AUTH_URL, el nombre anterior, se sigue aceptando.)
# API_URL=http://localhost:8080

# URL base de cada módulo del frontend. Por defecto cada uno llama a "/api/<módulo>", que el dev server
# de Vite reenvía al backend. Define estas variables en entornos donde el backend tenga otra URL
# (hoy las dos apuntan al mismo backend).
# VITE_SUPER_ADMIN_AUTH_API_URL=https://api.example.com
# VITE_ONBOARDING_API_URL=https://api.example.com
