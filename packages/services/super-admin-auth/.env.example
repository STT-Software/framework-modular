# Copy this file to ".env" and fill in the values. ".env" is NOT committed.
# MongoDB runs from the shared dev infrastructure: see infra/.env.example.

# Connection to this service's own database. The password must match
# SUPER_ADMIN_AUTH_DB_PASSWORD in infra/.env. If it has special characters
# (@ : / ?), they must be URL-encoded.
MONGODB_URI=mongodb://super_admin_auth:<password>@localhost:27017/super_admin_auth?authSource=super_admin_auth

PORT=8080
# Frontend origin allowed by CORS.
CORS_ORIGIN=http://localhost:6020

# Minimum 32 characters. Generate one with:  openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=1h
