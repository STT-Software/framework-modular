{
  "name": "@stt/framework-modular",
  "version": "1.0.0",
  "description": "Framework modular: base común para centralizar los módulos del equipo",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix packages/apps/web/modules/app",
    "build": "npm run build --prefix packages/apps/web/modules/app",
    "typecheck": "npm run typecheck --prefix packages/apps/web/modules/app",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "dev:api": "npm run dev --prefix packages/services/necto-api",
    "build:api": "npm run build --prefix packages/services/necto-api",
    "test:api": "npm test --prefix packages/services/necto-api"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/apps/web"
  ]
}
