# Copy this file to ".env" only if you need to override the defaults.

# URL base del servicio super-admin-auth. Por defecto la app llama a
# "/api/super-admin-auth", que el dev server de Vite reenvía al servicio.
# Define esta variable en entornos donde el servicio tenga otra URL.
# VITE_SUPER_ADMIN_AUTH_API_URL=https://auth.example.com

# Solo para el dev server: dónde corre el servicio (por defecto http://localhost:8080).
# SUPER_ADMIN_AUTH_URL=http://localhost:8080
